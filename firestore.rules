rules_version = '2';

// Session logs are written and read only by the proxy, which signs in with a
// service account (service accounts bypass these rules). No browser, signed in
// or not, may touch anything: a participant's page never talks to Firestore.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
