# Copy this file to .env (never commit .env; it is git-ignored) and add your key.
# Only the proxy reads these. The editor never sees the key: Vite's root is
# apps/editor, so a .env here is not loaded into the browser bundle, and CI fails
# the build if any key pattern shows up in dist/.

# Which model provider the proxy calls: gemini, openrouter or bayleaf.
# Leave empty to use the first one with a key. For one run: npm run dev -- bayleaf
LLM_PROVIDER=

# --- Gemini ---
# API key (https://aistudio.google.com/apikey). VITE_LLM_API_KEY also works.
GEMINI_API_KEY=
# Model the proxy calls.
VITE_LLM_MODEL_NAME=gemini-3.7-flash

# --- OpenRouter ---
# API key (https://openrouter.ai/keys).
OPENROUTER_API_KEY=
# Any id from https://openrouter.ai/models
OPENROUTER_MODEL=z-ai/glm-5.3-flash

# --- BayLeaf (https://api.bayleaf.dev, free for UCSC) ---
# Leave the key empty on the UCSC network ("campus" is used, 100 requests/day per address),
# or sign in at https://api.bayleaf.dev/login for a personal key.
BAYLEAF_API_KEY=
# Any id from https://api.bayleaf.dev/v1/models
BAYLEAF_MODEL=openrouter:z-ai/glm-5.3-flash

# OpenRouter / BayLeaf: for models that must think (thinking can't be turned off), a small
# effort such as low keeps calls fast. Empty = PROXY_THINKING_BUDGET below decides.
PROXY_REASONING_EFFORT=

# Local development: accept the built-in "dev" token so the editor needs no launcher link.
PROXY_OPEN=1

# Turn the model's thinking off (all providers). With thinking on, a call takes far longer than a ghost can wait.
PROXY_THINKING_BUDGET=0

# Where the proxy listens (the editor expects http://localhost:8787).
PROXY_PORT=8787
