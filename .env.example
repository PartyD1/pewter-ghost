# Copy this file to .env (never commit .env; it is git-ignored) and add your key.
# Only the proxy reads these. The editor never sees the key: Vite's root is
# apps/editor, so a .env here is not loaded into the browser bundle, and CI fails
# the build if any key pattern shows up in dist/.

# Gemini API key (https://aistudio.google.com/apikey). VITE_LLM_API_KEY also works.
GEMINI_API_KEY=

# Model the proxy calls.
VITE_LLM_MODEL_NAME=gemini-3.7-flash

# Local development: accept the built-in "dev" token so the editor needs no launcher link.
PROXY_OPEN=1

# Turn the model's thinking off. With thinking on, a call takes far longer than a ghost can wait.
PROXY_THINKING_BUDGET=0

# Where the proxy listens (the editor expects http://localhost:8787).
PROXY_PORT=8787
